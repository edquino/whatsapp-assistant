# ── Identidad de la instancia ─────────────────────────────────────────────────
LINE_NAME=maurisito           # Identificador de línea (usado como FK en la DB)

# ── Meta / WhatsApp Cloud API ─────────────────────────────────────────────────
META_VERIFY_TOKEN=           # Token que vos elegís para verificar el webhook con Meta
META_APP_SECRET=             # App Secret del app en Meta for Developers
WABA_PHONE_NUMBER_ID=        # Phone Number ID del WABA del asistente
WABA_ACCESS_TOKEN=           # Token de acceso permanente (System User)

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_PATH=data/whatsapp.db     # SQLite local (sandbox). Cambiar a DATABASE_URL para Postgres.

# ── Servidor (FastAPI) ────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
